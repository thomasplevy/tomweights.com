---
layout: layouts/page.njk
title: Blog
permalink: /blog/
---
<p class="blog-links"><a href="/blog/start-here/">Start here</a> <span aria-hidden="true">·</span> <a href="/blog/archive/">Archive</a> <span aria-hidden="true">·</span> <a href="/blog/tags/">Tags</a></p>
{% if collections.posts.length %}
<ul class="post-list">
	{% for post in collections.posts %}
	<li>
		<time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
		<h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
		{% if post.data.description %}
		<p>{{ post.data.description }}</p>
		{% endif %}
	</li>
	{% endfor %}
</ul>
{% else %}
<p>No posts yet.</p>
{% endif %}
