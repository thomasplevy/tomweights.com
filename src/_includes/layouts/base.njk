<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="max-image-preview:large">
	<title>{% if title and title != site.name %}{{ title }} – {{ site.name }}{% else %}{{ site.name }} – {{ site.tagline }}{% endif %}</title>
	<meta name="description" content="{{ description or site.description }}">
	<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	{# Open Graph and Twitter cards. Set `image` (root-relative path) and `imageAlt` in front matter for a preview image. #}
	<meta property="og:site_name" content="{{ site.name }}">
	<meta property="og:title" content="{{ title or site.name }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:type" content="{% if '/blog/posts/' in page.inputPath or '/reviews/' in page.inputPath %}article{% else %}website{% endif %}">
	<meta property="og:url" content="{{ site.url }}{{ page.url }}">
	{% if image %}
	<meta property="og:image" content="{{ site.url }}{{ image }}">
	<meta property="og:image:alt" content="{{ imageAlt }}">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:image" content="{{ site.url }}{{ image }}">
	<meta name="twitter:image:alt" content="{{ imageAlt }}">
	{% endif %}
	<link rel="alternate" type="application/rss+xml" title="{{ site.name }} » Feed" href="/feed/">
	<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32">
	<link rel="icon" href="/assets/img/favicon.png" sizes="192x192">
	<link rel="apple-touch-icon" href="/assets/img/favicon.png">
	<link rel="preload" href="/assets/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="/assets/css/style.css">
	{% include "partials/json-ld.njk" %}
</head>
<body class="{% if page.url == '/' %}home{% else %}page{% endif %}">
	<a class="skip-link" href="#content">Skip to content</a>
	<div class="site">
		{% include "partials/header.njk" %}
		{{ content | safe }}
		{% include "partials/footer.njk" %}
	</div>
	<script src="/assets/js/nav.js"></script>
</body>
</html>
