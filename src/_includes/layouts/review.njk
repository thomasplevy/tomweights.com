---
layout: layouts/base.njk
---
<main id="content" class="content content--page">
	<div class="review-top">
		{% if coverImage %}
		<figure class="book__cover review-cover">
			<picture>
				{% if coverImage.page.webpSrcset %}<source type="image/webp" srcset="{{ coverImage.page.webpSrcset }}" sizes="(min-width: 700px) 200px, 160px">{% endif %}
				<img src="{{ coverImage.page.src }}"{% if coverImage.page.srcset %} srcset="{{ coverImage.page.srcset }}" sizes="(min-width: 700px) 200px, 160px"{% endif %} width="{{ coverImage.page.width }}" height="{{ coverImage.page.height }}" alt="{{ coverImage.alt }}">
			</picture>
		</figure>
		{% endif %}
		<div class="page-header">
			<h1>{{ title }}</h1>
		</div>
	</div>
	<div class="entry">
		<p class="review-author">by {{ author }}</p>
		<p class="post-meta review-meta">
			<span class="review-rating" role="img" aria-label="Rated {{ rating }} out of 5">{{ rating | starIcons | safe }}</span>
			<time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time>
		</p>
		{{ content | safe }}
		{% if isbn %}
		<p class="review-buy"><a href="{{ (bookshopIsbn or isbn) | bookshopUrl(bookshop.affiliateId) }}" rel="noopener">Buy on Bookshop.org</a></p>
		<p class="post-meta">ISBN {{ isbn }}</p>
		{% endif %}
	</div>
</main>
