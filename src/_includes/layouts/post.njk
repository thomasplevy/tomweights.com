---
layout: layouts/base.njk
---
<main id="content" class="content content--page">
	<div class="page-header">
		<h1>{{ title }}</h1>
	</div>
	<div class="entry">
		<p class="post-meta">
			<time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time>
			<span aria-hidden="true">·</span> {{ content | readingTime }}
		</p>
		{{ content | safe }}
	</div>
	{% include "partials/post-footer.njk" %}
</main>
