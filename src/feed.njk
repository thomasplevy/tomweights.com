---
permalink: /feed/index.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
	<channel>
		<title>{{ site.name }}</title>
		<atom:link href="{{ site.url }}/feed/" rel="self" type="application/rss+xml"/>
		<link>{{ site.url }}/</link>
		<description>{{ site.description }}</description>
		<language>{{ site.language }}</language>
		<generator>Eleventy</generator>
		{% for post in collections.posts %}
		{% set postUrl = site.url + post.url %}
		<item>
			<title>{{ post.data.title | xmlEscape | safe }}</title>
			<link>{{ site.url }}{{ post.url }}</link>
			<guid>{{ site.url }}{{ post.url }}</guid>
			<pubDate>{{ post.date | rfc822 }}</pubDate>
			<dc:creator>{{ site.author | xmlEscape | safe }}</dc:creator>
			<description>{{ post.data.description | xmlEscape | safe }}</description>
			<content:encoded>{{ post.content | htmlToAbsoluteUrls(postUrl) | xmlEscape | safe }}</content:encoded>
		</item>
		{% endfor %}
	</channel>
</rss>

